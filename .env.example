# Docker environment template. Copy to .env only for local development; never commit real secrets.
# Every `change-me` / `local-development-only` value is intentionally rejected when APP_ENV=production.

# APP_ENV — required: runtime environment. Local: development. Production: production; use non-default secrets below.
APP_ENV=development
# APP_MOCK_MODE — required: use deterministic Mock adapters; local true needs no model API key. Production: set explicitly.
APP_MOCK_MODE=true
# APP_LITE_MODE — recommended for personal use and small teams. Runs tasks in
# the API process and removes Redis, MinIO and the separate Worker.
APP_LITE_MODE=true
# DEMO_SEED_ENABLED — required only for the one-shot demo-seed job. Local false; production must remain false unless explicitly approved.
DEMO_SEED_ENABLED=false
# VCS_REF — optional source revision label. Local: unknown. Production: CI commit SHA; not a secret.
VCS_REF=unknown

# WEB_ORIGIN — required browser CORS origin. Local: http://localhost:3000. Production: exact HTTPS public origin.
WEB_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_API_URL — required public API URL; local http://localhost:8000. Production: public HTTPS API URL; never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
# WEB_PORT/API_PORT — optional localhost published ports. Production: leave unpublished or bind through a reverse proxy.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=55432
S3_PORT=9000
S3_CONSOLE_PORT=9001
# *_BIND_ADDRESS — optional local exposure only. Production: 127.0.0.1 or remove published ports; do not expose data services publicly.
POSTGRES_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
S3_BIND_ADDRESS=127.0.0.1

# Lite object storage is a local Docker volume served through signed API URLs.
API_PUBLIC_URL=http://localhost:8000
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/objects

# POSTGRES_* — required database credentials. Local examples below are development-only. Production: unique secret password from a secret manager.
POSTGRES_DB=operations_ai
POSTGRES_USER=operations_ai
POSTGRES_PASSWORD=local-development-only
# DATABASE_URL — assembled internally by Compose. Local development uses the POSTGRES values; production must use TLS/network controls.

# REDIS_URL — full edition only. Lite mode does not connect to Redis.
REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT/S3_PUBLIC_ENDPOINT — full edition only. Lite mode uses LOCAL_STORAGE_PATH.
S3_ENDPOINT=http://object-storage:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_BUCKET — required bucket name. Local: operations-ai. Production: a dedicated non-public bucket.
S3_BUCKET=operations-ai
# S3_ACCESS_KEY/S3_SECRET_KEY — required object credentials. Local values only; production must use unique secret-manager values.
S3_ACCESS_KEY=operations-ai
S3_SECRET_KEY=local-development-only
# STORAGE_SIGNING_SECRET — required signing key. Local placeholder only; production must be long, random, and never logged.
STORAGE_SIGNING_SECRET=local-development-signing-secret-change-me
# MODEL_SECRET_ENCRYPTION_KEY — required when APP_ENV is not development. Local placeholder; production must be random and at least 32 chars.
MODEL_SECRET_ENCRYPTION_KEY=local-development-model-secret-change-me
# SESSION/security secrets — required when session features are enabled. Local uses generated test values; production must be distinct random values.
SESSION_SIGNING_SECRET=local-development-session-secret-change-me

# LOG_LEVEL — optional log verbosity. Local: INFO. Production: INFO or WARN; logs must not contain credentials.
LOG_LEVEL=INFO
# RATE_LIMIT_* — required policy defaults. Local values below; production must be reviewed for expected traffic and abuse controls.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_EXPORT_PER_FIVE_MINUTES=10
RATE_LIMIT_DESTRUCTIVE_PER_TEN_MINUTES=5
RATE_LIMIT_DEMO_FACTOR=0.25
